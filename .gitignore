# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Template contoh tetap di-commit agar bisa dirujuk (lihat README-DEPLOY-CLOUDFLARE.md)
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
/test
prompt

server.log
# Skills directory
/skills/

# Inbox Telegram (foto unduhan bot — jangan commit)
/upload/telegram-kunjungan/
/upload/telegram-service/
/upload/telegram-inbox/

# Arsip lokal — jangan commit (besar & turunan, bukan sumber)
project.zip
project/
download/
upload/
*.bak
*.bak-*
db/backups/
db/custom.db
# SQLite WAL — file ikutan saat mode WAL aktif (jangan commit)
db/custom.db-wal
db/custom.db-shm
# Salinan DB di folder build standalone
.next/standalone/db/
# Cache data bahasa Tesseract (30 MB, diunduh ulang via npm run tessdata)
.cache/

# Output build desktop (electron-builder) - artefak, jangan di-commit
/dist/

# Acuan dependency tunggal: npm (package-lock.json). bun.lock dibiarkan lokal
# saja agar tidak terjadi drift dua lockfile.
/bun.lock

# Playwright (E2E) — artefak & DB uji, jangan di-commit
/test-results/
/playwright-report/
/blob-report/
/e2e/.tmp/