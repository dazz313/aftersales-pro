generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODUL 1.3 - Master Employee & User Management
// ==========================================
model Pengguna {
  id           Int         @id @default(autoincrement())
  nama         String
  email        String      @unique
  username     String?     @unique // login alternatif selain email
  kodeTeknisi  String?     @unique // kode teknisi/karyawan (mis. TKN-001), opsional & unik
  passwordHash String?     // scrypt: scrypt$<salt>$<hash> (null = belum bisa login)
  role         String      @default("TEKNISI") // ADMIN_WORKSHOP | TEKNISI | MANAGER | PRODUSEN
  noWa         String?
  wilayahKerja String? // pemetaan wilayah kerja teknisi
  aktif        Boolean     @default(true)
  createdAt    DateTime    @default(now())
  kunjungan    Kunjungan[]
}

// ==========================================
// 1. Master Store Table (master_toko)
// ==========================================
model MasterToko {
  id               Int         @id @default(autoincrement())
  kodeToko         String      @unique
  namaToko         String
  alamat           String?
  kontak           String?
  frekuensiVisit   Int         @default(14) // siklus kunjungan dalam hari
  tglVisitTerakhir DateTime?
  barcodeToko      String      @unique @default("") // barcode per-TOKO (bukan per unit) untuk identifikasi kunjungan
  createdAt        DateTime    @default(now())
  unitAssets       UnitAsset[]
  kunjungan        Kunjungan[]
  orders           PermintaanOrder[]
}

// ==========================================
// 2. Master Customer Table (master_customer)
// ==========================================
model MasterCustomer {
  id         Int         @id @default(autoincrement())
  nama       String
  noWa       String?
  alamat     String?
  createdAt  DateTime    @default(now())
  unitAssets UnitAsset[]
  orders     PermintaanOrder[]
}

// ==========================================
// 3. Master Sparepart Table (master_sparepart)
// ==========================================
model MasterSparepart {
  id             Int                  @id @default(autoincrement())
  kodePart       String               @unique
  namaPart       String
  // 5 komponen utama sparepart:
  // 1. kodePart (kode sparepart) · 2. namaPart (nama sparepart)
  // 3. brandKompatibel (brand kompatibel, koma-dipisah mis. "Samsung, LG")
  // 4. stokJual (bisa dijual) + stokGaransi (stok garansi/klaim) — stokInventory = total
  // 5. supplier (nama supplier)
  brandKompatibel String              @default("")
  supplier        String              @default("")
  // Stok BRAND (fisik di gudang) — hanya bergerak saat stok masuk/keluar gudang.
  stokJual       Int                  @default(0)
  stokGaransi    Int                  @default(0)
  stokInventory Int                  @default(0)
  // Pemakaian per unit — part ORDER khusus unit TIDAK menyentuh stok brand,
  // hanya dicatat di sini agar "banyaknya part terpakai" tetap terlihat.
  totalTerpakai  Int                  @default(0)
  reorderLimit   Int                  @default(5)
  hargaKlaim     Float                @default(0) // nilai klaim per unit ke produsen
  createdAt      DateTime             @default(now())
  serviceParts   ServiceRequestPart[]
  orders         PermintaanOrder[]
}

// ==========================================
// 4. Unit Asset / Barcode Table (unit_asset)
// Format barcode: SN:[serial_number]|MOD:[model_unit]|TOK:[kode_toko]
// ==========================================
model UnitAsset {
  id              Int              @id @default(autoincrement())
  serialNumber    String           @unique
  modelUnit       String
  merk            String           @default("") // merk/brand unit (mis. Samsung, Daikin)
  nama            String           @default("") // nama panggilan unit (mis. "AC Ruang Tamu")
  tokoId          Int?
  customerId      Int?
  statusGaransi   String           @default("GARANSI") // GARANSI | NON_GARANSI
  tglPembelian    DateTime?
  createdAt       DateTime         @default(now())
  toko            MasterToko?      @relation(fields: [tokoId], references: [id])
  customer        MasterCustomer?  @relation(fields: [customerId], references: [id])
  serviceRequests ServiceRequest[]
}

// ==========================================
// 5. Onsite Store Visit Table (kunjungan)
// ==========================================
model Kunjungan {
  id               Int        @id @default(autoincrement())
  tokoId           Int
  teknisiId        Int
  tglKunjungan     DateTime   @default(now())
  metodeCheckin    String     @default("MANUAL") // SCAN_BARCODE (scan barcode toko) | MANUAL
  barcodeTerscan   String?    // nilai barcode toko yang dipindai
  fotoOnsite       String?
  catatanStokRusak String?
  toko             MasterToko @relation(fields: [tokoId], references: [id])
  teknisi          Pengguna   @relation(fields: [teknisiId], references: [id])
}

// ==========================================
// 6. Service Request Main Table (service_request)
// status: REQUEST | PROSES | FINISH
// status_klaim_produsen: DRAFT | SUBMITTED | PAID
// --- Alur service lapangan (toko → produsen → workshop → toko):
// sumberLaporan: KUNJUNGAN | LAPORAN_TOKO | LAPORAN_CUSTOMER | WA_BOT | MANUAL
// lokasiUnit: TOKO (unit di toko) | WORKSHOP (ditarik via STTB)
// penanganan: BELUM | TUNGGU_PART_TOKO (teregistrasi, simpan di toko krn part tidak ready)
//             | DI_TOKO (dikerjakan di toko) | TARIK_WORKSHOP (ditarik + STTB)
// noSuratJalan: nomor SJ saat part rusak dikirim ke produsen
// sttbDicabut: true saat unit kembali ke toko (STTB dicabut)
// ==========================================
model ServiceRequest {
  id                  Int                  @id @default(autoincrement())
  noTiket             String               @unique
  unitAssetId         Int
  status              String               @default("REQUEST")
  noSttb              String?
  sumberLaporan       String               @default("MANUAL")
  tipeCustomer        String               @default("PERORANGAN") // TOKO (stok toko → otomatis garansi) | PERORANGAN
  lokasiUnit          String               @default("TOKO")
  penanganan          String               @default("BELUM")
  noSuratJalan        String?
  sttbDicabut         Boolean              @default(false)
  tglKembaliKeToko    DateTime?
  deskripsiKerusakan  String?
  fotoKerusakanWa     String?
  fotoNotaStempel     String?
  tandaTanganDigital  String?
  slaFlag             Boolean              @default(false) // ALT-02 flag merah
  statusKlaimProdusen String               @default("DRAFT")
  tglKlaim            DateTime?
  biayaJasa           Float                @default(0)
  tglFinish           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  unitAsset           UnitAsset            @relation(fields: [unitAssetId], references: [id])
  parts               ServiceRequestPart[]
}

// ==========================================
// 7. Service Request Sparepart Junction (service_request_part)
// status_part: READY | ORDER_PRODUSEN
// status_konfirmasi: jawaban produsen via WA — MENUNGGU | READY | TIDAK_READY
// ==========================================
model ServiceRequestPart {
  id               Int             @id @default(autoincrement())
  serviceRequestId Int
  sparepartId      Int
  qty              Int             @default(1)
  statusPart       String          @default("READY")
  statusKonfirmasi String          @default("MENUNGGU")
  sumberPart       String          @default("KATALOG") // KATALOG | PRODUSEN (kode dari balasan produsen)
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id])
  sparepart        MasterSparepart @relation(fields: [sparepartId], references: [id])
}

// ==========================================
// 8. Permintaan Order Sparepart dari Customer (customer_order)
// Customer (toko/perorangan) memesan part — termasuk part yang stok
// titipannya kosong. Status: BARU | DITERUSKAN | DATANG | SELESAI | BATAL
// - DITERUSKAN: order diteruskan ke produsen/supplier
// - DATANG: part tiba → stok inventory (bisa jual) otomatis bertambah
// - SELESAI: part diserahkan ke pemesan
// ==========================================
model PermintaanOrder {
  id           Int              @id @default(autoincrement())
  noOrder      String           @unique
  tipeCustomer String           @default("PERORANGAN") // TOKO | PERORANGAN
  tokoId       Int?
  customerId   Int?
  namaPemesan  String
  sparepartId  Int?
  kodePart     String
  namaPart     String
  brand        String           @default("")
  qty          Int              @default(1)
  status       String           @default("BARU")
  catatan      String?
  createdAt    DateTime         @default(now())
  tglSelesai   DateTime?
  toko         MasterToko?      @relation(fields: [tokoId], references: [id])
  customer     MasterCustomer?  @relation(fields: [customerId], references: [id])
  sparepart    MasterSparepart? @relation(fields: [sparepartId], references: [id])
}

// ==========================================
// MODUL 6 - Audit Activity Logs
// ==========================================
model AuditLog {
  id        Int      @id @default(autoincrement())
  aksi      String
  entitas   String
  entitasId String?
  deskripsi String
  aktor     String   @default("SYSTEM")
  createdAt DateTime @default(now())
}

// ==========================================
// WhatsApp Gateway Message Log (simulasi WA Bot)
// tipe: IN (masuk ke sistem) | OUT (balasan bot)
// ==========================================
// Gateway message log — mendukung multi-channel
// channel: WHATSAPP | TELEGRAM ; tipe: IN (masuk) | OUT (balasan bot)
model WaMessage {
  id        Int      @id @default(autoincrement())
  pengirim  String
  grup      String   @default("Gateway Group Produsen")
  channel   String   @default("WHATSAPP")
  tipe      String // IN | OUT
  pesan     String
  meta      String? // JSON: noTiket, aksi bot, dll
  createdAt DateTime @default(now())
}

// ==========================================
// MODUL 6 - Backup Otomatis Google Spreadsheet
// status: SUCCESS (tersinkron ke Google Sheets) | LOCAL (fallback snapshot lokal) | FAILED
// trigger: MANUAL | AUTO
// ==========================================
model BackupLog {
  id            Int      @id @default(autoincrement())
  status        String
  trigger       String   @default("MANUAL")
  sheetsWritten Int      @default(0)
  rowsTotal     Int      @default(0)
  tabel         String?  // daftar tabel yang dibackup
  message       String?
  createdAt     DateTime @default(now())
}

// ==========================================
// MODUL 6 - System Settings (Profil, Gateway WA/Telegram, Backup Google Sheets)
// ==========================================
model Pengaturan {
  id    Int    @id @default(autoincrement())
  kunci String @unique
  nilai String
}

// ==========================================
// Hasil pindai foto/barcode (Telegram webhook & upload manual)
// sumber: TELEGRAM_WEBHOOK | UPLOAD ; status: OK | GAGAL_BACA | FILE_NON_GAMBAR
// ==========================================
model VisionScan {
  id            Int      @id @default(autoincrement())
  sumber        String   @default("TELEGRAM_WEBHOOK")
  pengirim      String   @default("UNKNOWN")
  fileName      String
  filePath      String // relatif, mis. upload/telegram-service/tg-xxx.jpg
  mime          String?
  caption       String?
  barcode       String?
  barcodeFormat String?
  ocrText       String?
  ocrConfidence Float?
  status        String   @default("OK")
  createdAt     DateTime @default(now())
}

// ==========================================
// Inbox Penampungan — buffer data/foto Telegram sebelum diteruskan ke fitur
// status: PENDING | APPROVED | REJECTED | ARCHIVED ; folder: KUNJUNGAN | SERVICE
// ==========================================
model InboxItem {
  id            Int       @id @default(autoincrement())
  pengirim      String    @default("UNKNOWN")
  chatId        String    @default("")
  fileName      String?
  filePath      String?
  mime          String?
  folder        String    @default("SERVICE")
  caption       String?
  barcode       String?
  barcodeFormat String?
  ocrText       String?
  ocrConfidence Float?
  status        String    @default("PENDING")
  tujuan        String? // SERVICE | KUNJUNGAN | ARSIP
  teksTerusan   String?
  hasilRef      String? // noTiket / KJ-{id} / TOKO:{kode} (petunjuk)
  alasanTolak   String?
  direviewOleh  String?
  direviewAt    DateTime?
  createdAt     DateTime  @default(now())
}
