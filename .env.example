# Contoh konfigurasi AfterSales Pro — salin menjadi .env lalu isi nilai produksi.
# .env TIDAK boleh di-commit ke git (sudah di .gitignore).

# Lokasi database SQLite (WAJIB path absolut — path relatif mengikuti folder prisma/)
DATABASE_URL=file:C:/path/ke/proyek/db/custom.db

# WAJIB di produksi: secret acak panjang untuk tanda tangan sesi login.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Tanpa ini server production MENOLAK boot.
AUTH_SECRET=

# OPSIONAL tapi SANGAT disarankan di produksi: secret webhook inbound (WA/Telegram).
# Bila diisi, pemanggil /api/wa/webhook & /api/telegram/webhook wajib
# menyertakan ?secret=NILAI atau header x-webhook-secret.
# Server produksi hanya MEMPERINGATKAN bila kosong; endpoint webhook publik
# (terutama bila diekspos lewat Cloudflare) bisa dipanggil siapa saja.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=

# Mode SameSite cookie sesi: auto | lax | strict | none
#  - auto   (default): HTTPS -> None+Secure (agar tetap jalan saat app di-embed
#                      iframe lintas situs) ; HTTP -> Lax.
#  - lax    (DISARANKAN untuk server sendiri di belakang Cloudflare yang diakses
#            top-level): lebih aman terhadap CSRF. Fallback Bearer di
#            localStorage tetap menangani kasus iframe yang memblokir cookie.
#  - strict : paling ketat.  - none : eksplisit None+Secure (butuh HTTPS).
# SESSION_COOKIE_SAMESITE=lax

# Port & host server (default Next.js: 3000)
# PORT=3000
# HOSTNAME=127.0.0.1

# KHUSUS UJI (E2E/CI): setel 1 untuk mematikan backup git otomatis (snapshot +
# commit) agar tes tidak mengubah db/snapshots/ maupun riwayat git repo.
# DISABLE_GIT_BACKUP=1
